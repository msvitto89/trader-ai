# ─────────────────────────────────────────────────────────────
# TRADIA AI — environment configuration
# Never expose server secrets to the browser. Only NEXT_PUBLIC_*
# variables are available in client code, and none of those may
# contain provider credentials.
# ─────────────────────────────────────────────────────────────

# Session signing secret (required in production)
TRADIA_SESSION_SECRET=change-me-to-a-long-random-string

# Database location (SQLite for the reference deployment)
TRADIA_DB_PATH=./data/tradia.db

# ── Market data ───────────────────────────────────────────────
# Providers: "demo" (deterministic DEMO DATA), "http" (any REST
# provider mapped through the documented adapter).
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# ── AI narrative layer (optional) ─────────────────────────────
# The deterministic TRADIA analysis engine always runs locally.
# If an OpenAI-compatible endpoint is configured, it is used only
# to phrase the narrative from structured engine output.
AI_PROVIDER=engine
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
